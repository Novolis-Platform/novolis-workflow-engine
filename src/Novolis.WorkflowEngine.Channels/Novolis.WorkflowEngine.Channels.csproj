<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.WorkflowEngine.Channels</PackageId>
    <RootNamespace>Novolis.WorkflowEngine.Channels</RootNamespace>
    <Description>System.Threading.Channels trigger adapter for Novolis workflows.</Description>
    <PackageTags>workflow;channels;hosting;messaging</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <LibraryReference Include="Novolis.Messaging.Channels" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Novolis.WorkflowEngine.Abstractions\Novolis.WorkflowEngine.Abstractions.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
