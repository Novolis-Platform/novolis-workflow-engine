<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.WorkflowEngine.Scheduling</PackageId>
    <RootNamespace>Novolis.WorkflowEngine.Scheduling</RootNamespace>
    <Description>Cron trigger adapter for Novolis workflows.</Description>
    <PackageTags>workflow;scheduling;cron;hosting</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Novolis.Scheduling" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Novolis.WorkflowEngine.Abstractions\Novolis.WorkflowEngine.Abstractions.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
